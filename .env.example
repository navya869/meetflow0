NODE_ENV=development
PORT=8000
CLIENT_ORIGIN=http://127.0.0.1:5173
MONGODB_URI=mongodb://127.0.0.1:27017/meetflow

# Generate separate random secrets of at least 32 characters for production.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
OTP_SECRET=replace-with-a-different-random-secret-at-least-32-characters

# SMTP email (port 465 uses TLS; port 587 uses STARTTLS).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Meetflow <no-reply@example.com>

# Google OAuth web client. Add the redirect URI below to your Google Cloud client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to ${CLIENT_ORIGIN}/api/auth/google/callback if left empty.
GOOGLE_REDIRECT_URI=
